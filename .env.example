# Copy to .env and adjust. docker compose loads .env automatically.

# ── Postgres ─────────────────────────────────────────────────────────────
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic
POSTGRES_DB=clinic
CLINIC_DB_DSN=postgres://clinic:clinic@db:5432/clinic?sslmode=disable

# ── Backend ──────────────────────────────────────────────────────────────
# Required: the backend refuses to start without it.
CLINIC_API_KEY=local-dev-key
CLINIC_DB_DRIVER=postgres
CLINIC_TIMEZONE=Asia/Shanghai

# ── CAS / auth ───────────────────────────────────────────────────────────
CAS_SERVER_URL=
CAS_HTTP_TIMEOUT=10s
CAS_DEFAULT_REDIRECT=/
APP_BASE_URL=http://localhost:8080
SESSION_COOKIE_NAME=sessionid
CSRF_COOKIE_NAME=csrf_token
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL=336h

# ── Keycloak (optional) ──────────────────────────────────────────────────
KEYCLOAK_REALM_URL=
KEYCLOAK_CLIENT_ID=
