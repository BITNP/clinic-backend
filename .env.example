# Copy to .env and adjust. docker compose loads .env automatically.

# ── Postgres ─────────────────────────────────────────────────────────────
POSTGRES_USER=clinic30
POSTGRES_PASSWORD=clinic
POSTGRES_DB=clinic30
# leave this empty or comment to make compose generate DSN
#CLINIC_DB_DSN=postgres://clinic:clinic@db:5432/clinic?sslmode=disable

# ── Backend ──────────────────────────────────────────────────────────────
# Required: the backend refuses to start without it.
CLINIC_API_KEY=local-dev-key
CLINIC_DB_DRIVER=postgres
CLINIC_TIMEZONE=Asia/Shanghai
# How often admin clients poll /api/admin/sync. 0s disables periodic polling.
SYNC_POLL_INTERVAL=10s

# ── Redis ────────────────────────────────────────────────────────────────
# Required: the backend refuses to start without a reachable Redis.
# Both compose files bundle a `redis` service reachable at redis:6379, so the
# default works as-is. REDIS_PASSWORD is also used as the password for the
# bundled prod Redis service. Point REDIS_ADDR at an external Redis to use it
# instead (e.g. host.containers.internal:6379).
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Object storage (S3) ──────────────────────────────────────────────────
# Required. The backend validates these settings and checks bucket access
# before accepting requests. Provision the bucket and application credentials
# before starting the backend; startup fails if the check cannot complete.
# Browser-facing endpoint used to sign upload/download URLs. Local development
# uses the published RustFS port; production uses https://s3.bitnp.net.
S3_ENDPOINT=http://localhost:9000
# Optional backend-only endpoint. Leave empty to use S3_ENDPOINT for everything.
# Leave empty for Compose too: it substitutes http://rustfs:9000 for the backend
# container. A host-run backend can set http://127.0.0.1:9000 if S3_ENDPOINT is
# not reachable from the host.
S3_INTERNAL_ENDPOINT=
# Production uses clinic-photos; local development can use a separate bucket.
S3_BUCKET=clinic-photos-dev
S3_REGION=us-east-1
# Dedicated application credentials. Never use the RustFS root account here.
# `rustfs-init` creates this user and attaches a bucket-scoped policy. Generate:
#   access key:  openssl rand -hex 16 | tr '[:lower:]' '[:upper:]'
#   secret key:  openssl rand -hex 24
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUT_URL_TTL=5m
S3_GET_URL_TTL=10m

# ── Bundled RustFS deployment ────────────────────────────────────────────
# Both compose files bundle a private RustFS instance. The bucket and
# application user are created by the one-shot `rustfs-init` service (see
# deploy/rustfs/). These are deployment settings; the backend reads the S3_*
# block above. The RustFS services run as part of this stack. Never commit
# actual credentials.
# RustFS defaults to latest; override to match the server image tag if needed.
RUSTFS_IMAGE_TAG=latest
# RustFS CLI image used by the one-shot bucket/user provisioner.
RUSTFS_CLI_IMAGE_TAG=v0.1.36
# Root credentials are only used for provisioning and break-glass
# administration. They are not passed to the backend. Generate with:
#   access key:  openssl rand -hex 16 | tr '[:lower:]' '[:upper:]'
#   secret key:  openssl rand -hex 24
# Access keys must not contain "/" and should use uppercase letters/digits.
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_LOG_LEVEL=info
# Host loopback port for the RustFS console (reach it through an SSH tunnel in
# production). The S3 API has no public host port in production.
RUSTFS_CONSOLE_PORT=9001
RUSTFS_CONSOLE_BIND_ADDRESS=127.0.0.1
# Host loopback port for the RustFS S3 API. Keep the bind address on loopback
# unless another machine must reach the instance.
S3_API_PORT=9000
RUSTFS_S3_BIND_ADDRESS=127.0.0.1
# Both frontend origins allowed to use signed upload/download URLs. Set the
# real HTTPS origins in production, for example:
# S3_CORS_ALLOWED_ORIGINS=https://admin.example.com,https://clinic.example.com
S3_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Pin a specific backend image version instead of latest.
BACKEND_IMAGE_TAG=latest

# ── Admin frontend (docker-compose.prod.yml) ─────────────────────────────
# Host port the admin frontend listens on.
ADMIN_FRONTEND_PORT=5173
# Pin a specific frontend image version instead of latest.
ADMIN_FRONTEND_IMAGE_TAG=latest
# Upstream the frontend proxies /api, /login, /logout to. Defaults to the
# backend service on the compose network (no change needed for prod).
BACKEND_UPSTREAM=http://backend:8080

# ── Outbound messaging (message-gateway) ─────────────────────────────────
# The gateway owns platform adapters, queues, rate limiting, and NapCat.
# The backend has no business caller wired yet. When one is added, use the
# account's client_token from message-gateway/accounts.json.
MESSAGE_GATEWAY_URL=http://127.0.0.1:8081
MESSAGE_GATEWAY_TIMEOUT=5s

# ── Health monitor (docker-compose.prod.yml) ─────────────────────────────
# The monitor runs in the production stack and alerts maintainers through the
# same message-gateway. MAINTAINER_QQ_IDS, MESSAGE_GATEWAY_ACCOUNT, and
# MESSAGE_GATEWAY_ACCOUNT_TOKEN are required when the production stack starts.
MESSAGE_GATEWAY_ACCOUNT=qq
# The client_token of that account in message-gateway/accounts.json.
MESSAGE_GATEWAY_ACCOUNT_TOKEN=
HEALTH_MONITOR_IMAGE_TAG=latest
# Comma-separated QQ user ids, for example: 10001,10002.
MAINTAINER_QQ_IDS=
# Target defaults to the backend service on the compose network.
MONITOR_TARGET_URL=http://backend:8080/healthz
MONITOR_TARGET_NAME=clinic-backend
MONITOR_INSTANCE_NAME=clinic-prod
MONITOR_INTERVAL=30s
MONITOR_TIMEOUT=5s
MONITOR_FAILURE_THRESHOLD=3
MONITOR_RECOVERY_THRESHOLD=1
MONITOR_ALERT_REPEAT_INTERVAL=0s
MONITOR_NOTIFY_RECOVERY=true

# Legacy NapCat settings are intentionally absent. Do not set NAPCAT_BASE_URL:
# the old in-process message manager must remain disabled.

# ── CAS / auth ───────────────────────────────────────────────────────────
CAS_SERVER_URL=
CAS_HTTP_TIMEOUT=10s
CAS_DEFAULT_REDIRECT=/
# Must point at the admin frontend for CAS login/logout redirects.
APP_BASE_URL=http://localhost:5173
SESSION_COOKIE_NAME=sessionid
CSRF_COOKIE_NAME=csrf_token
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL=336h

# Raise this to force all staff to log in again on the next deployment. Each
# bump invalidates every session until the staff re-login once.
STAFF_VERSION=0

# ── Keycloak (optional) ──────────────────────────────────────────────────
KEYCLOAK_REALM_URL=
KEYCLOAK_CLIENT_ID=

# ── Tagger agent ─────────────────────────────────────────────────────────
# In-process Eino tagger. Tagging is disabled (records keep the default
# no_pending tag) while TAGGER_LLM_API_KEY is empty.
TAGGER_LLM_API_KEY=
# OpenAI-compatible endpoint and model ID. Both are required when the API key
# is set. DeepSeek example:
#   TAGGER_LLM_BASE_URL=https://api.deepseek.com/v1
#   TAGGER_LLM_MODEL=deepseek-v4-flash
TAGGER_LLM_BASE_URL=
TAGGER_LLM_MODEL=
# Long-lived chat models/sessions per tag set. Minimum 1. The backend creates
# one pool for record tags and one for liquid-metal tags.
TAGGER_AGENT_POOL_SIZE=4
# Reset a session once its context reaches this many tokens. Keep it below the
# model's context window.
TAGGER_CONTEXT_TOKENS=32000
# Per-call timeout, including waiting for a free session.
TAGGER_TIMEOUT=30s

# ── Records ──────────────────────────────────────────────────────────────
# How long a staff member can undo their latest record action ("后悔药").
# Actions older than this window are no longer revertible.
RECORD_ACTION_WINDOW=5m
# Maximum number of ordered photos attached to one record's worker notes.
RECORD_PHOTO_MAX_COUNT=9
# Maximum size of one uploaded photo in bytes (10 MiB).
RECORD_PHOTO_MAX_SIZE_BYTES=10485760
