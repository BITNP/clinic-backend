      "value_type": "int",
      "group": "system",
      "sort_order": 6,
      "is_required": true,
      "role_level": "superadmin"
    },
    {
      "name": "TAGGER_TIMEOUT",
      "display_name": "标签模型超时时间",
      "hint": "Go 时长格式，必须大于 0。",
      "value_type": "string",
      "group": "system",
      "sort_order": 7,
      "is_required": true,
      "role_level": "superadmin"
    },
    {
      "name": "RECORD_ACTION_WINDOW",
      "display_name": "操作撤销时限",
      "value_type": "string",
      "group": "record",
      "sort_order": 0,
      "is_required": true,
      "role_level": "admin"
    },
    {
      "name": "RECORD_PHOTO_MAX_COUNT",
      "display_name": "单条工单照片上限",
      "value_type": "int",
      "group": "record",
      "sort_order": 1,
      "is_required": true,
      "role_level": "admin"
    },
    {
      "name": "RECORD_PHOTO_MAX_SIZE_BYTES",
      "display_name": "单张照片大小上限",
      "unit": "字节",
      "hint": "按字节填写；保存后下一次上传立即使用该限制。",
      "value_type": "int",
      "group": "record",
      "sort_order": 2,
      "is_required": true,
      "role_level": "admin"
    },
    {
      "name": "SERVICE_DATE_REMINDER_ENABLED",
      "display_name": "启用服务日期提醒",
      "hint": "关闭后暂停新的提醒发现和发送；已提交的消息可能仍会送达。",
      "value_type": "boolean",
      "group": "reminder",
      "sort_order": 0,
      "is_required": true,
      "role_level": "admin"
    },
    {
      "name": "SERVICE_DATE_REMINDER_LEAD_TIMES",
      "display_name": "提前提醒时间列表",
      "hint": "使用逗号分隔的 Go 时长，例如 5h,3h；每个值必须为正且至少精确到秒。",
      "value_type": "string",
      "group": "reminder",
      "sort_order": 1,
      "is_required": true,
      "role_level": "admin"
    },
    {
      "name": "SERVICE_DATE_REMINDER_TEMPLATE",
      "display_name": "提醒消息模板",
      "hint": "支持 {{.Date}}、{{.StartTime}}、{{.Room}}、{{.PendingCount}} 和 {{.LeadTime}}；保存后下一条提醒生效。",
      "value_type": "string",
      "group": "reminder",
      "sort_order": 2,
      "is_required": true,
      "role_level": "admin",
      "default": "[电脑诊所]{{.Date}} {{.StartTime}} {{.Room}} 的值班还有{{.PendingCount}}个待审核工单，请及时处理。"
    },
    {
      "name": "MESSAGE_GATEWAY_URL",
      "display_name": "消息网关地址",
      "hint": "message-gateway 基础地址，必须使用 HTTP(S)，不能包含查询参数或片段。",
      "value_type": "string",
      "group": "reminder",
      "sort_order": 3,
      "is_required": false,
      "role_level": "superadmin",
      "default": ""
    },
    {
      "name": "MESSAGE_GATEWAY_ACCOUNT",
      "display_name": "消息网关账号",
      "hint": "下一条提醒立即使用该账号；网关账号令牌必须与账号匹配。",
      "value_type": "string",
      "group": "reminder",
      "sort_order": 4,
      "is_required": true,
      "role_level": "superadmin",
      "default": "qq"
    },
    {
      "name": "MESSAGE_GATEWAY_ACCOUNT_TOKEN",
      "display_name": "消息网关账号令牌",
      "hint": "仅写入；必须是当前消息网关账号的 client_token。",
      "value_type": "string",
      "group": "reminder",
      "sort_order": 5,
      "is_required": false,
      "role_level": "superadmin",
      "writeonly": true,
      "default": ""
    },
    {
      "name": "MESSAGE_GATEWAY_TIMEOUT",
      "display_name": "消息网关请求超时",
      "hint": "Go 时长格式，必须大于 0；下一条提醒发送时生效。",
      "value_type": "string",
      "group": "reminder",
      "sort_order": 6,
      "is_required": true,
      "role_level": "superadmin",
      "default": "5s"
    }
  ]
}
