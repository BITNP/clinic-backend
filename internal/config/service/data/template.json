      "sort_order": 1,
      "is_required": true,
      "role_level": "admin"
    },
    {
      "name": "TAGGER_LLM_API_KEY",
      "display_name": "标签模型 API 密钥",
      "hint": "仅写入；保存后不会回显当前密钥。",
      "value_type": "string",
      "group": "system",
      "sort_order": 2,
      "is_required": false,
      "role_level": "superadmin",
      "writeonly": true
    },
    {
      "name": "TAGGER_LLM_BASE_URL",
      "display_name": "标签模型 API 地址",
      "hint": "OpenAI 兼容接口地址；填写密钥时必填。",
      "value_type": "string",
      "group": "system",
      "sort_order": 3,
      "is_required": false,
      "role_level": "superadmin"
    },
    {
      "name": "TAGGER_LLM_MODEL",
      "display_name": "标签模型名称",
      "hint": "模型 ID；填写密钥时必填。",
      "value_type": "string",
      "group": "system",
      "sort_order": 4,
      "is_required": false,
      "role_level": "superadmin"
    },
    {
      "name": "TAGGER_AGENT_POOL_SIZE",
      "display_name": "标签模型并发会话数",
      "unit": "并发",
      "hint": "扩容立即生效；缩容会等待多余的在途任务结束。",
      "value_type": "int",
      "group": "system",
      "sort_order": 5,
      "is_required": true,
      "role_level": "superadmin"
    },
    {
      "name": "TAGGER_CONTEXT_TOKENS",
      "display_name": "标签模型上下文上限",
      "unit": "tokens",
